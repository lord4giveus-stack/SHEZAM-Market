rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.uid == 'drYy4WWfhSR431WqTwprSujHNEK2';
    }
    match /products/{productId} {
      allow read: if isAdmin() || resource.data.active == true;
      allow create: if isAdmin() && validProduct();
      allow update: if isAdmin() && validProduct();
      allow delete: if isAdmin();
    }
    function validProduct() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name','category','price','imageUrl','active','createdAt'])
        && d.keys().hasAll(['name','category','price','imageUrl','active'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 120
        && d.category is string && d.category.size() > 0 && d.category.size() <= 80
        && d.price is number && d.price >= 0
        && d.imageUrl is string && d.imageUrl.size() <= 2000
        && d.active is bool;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
